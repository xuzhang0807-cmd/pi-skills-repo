{
  "schema_version": 2,
  "checked_on": "2026-10-04",
  "description": "Upstream sources for office/, permanent/ and project/. Read INSTALL.md before installing; adapt with scripts/adapt.mjs. Never edit the snapshot directories - adaptations live in the installed copy and patches/.",
  "harness_detection": {
    "order": "first match wins",
    "rules": [
      {
        "harness": "claude-code",
        "when": "CLAUDE_PLUGIN_ROOT is set, or skills are installed under .claude/skills/"
      },
      {
        "harness": "codex",
        "when": "CODEX_HOME is set, or skills are installed under ~/.codex/skills/"
      },
      {
        "harness": "hermes",
        "when": "the process or config mentions Hermes"
      },
      {
        "harness": "pi",
        "when": "none of the above"
      }
    ],
    "registration": "Skills register by the SKILL.md 'name:' field, never by directory name."
  },
  "install": {
    "layout": "Copy each skill directory from permanent/ and project/ flat into the harness skills search path as its own directory. Do not nest, do not install permanent/ or project/ as a single skill.",
    "adapt_command": "node scripts/adapt.mjs --apply --dest <install-path> --repo-root <repo-root>",
    "check_command": "node scripts/adapt.mjs --check --dest <install-path> --repo-root <repo-root>",
    "revert_command": "node scripts/adapt.mjs --revert --dest <install-path> --skill <directory-name>",
    "rules": [
      "Never edit office/, permanent/ or project/ - they are byte-identical upstream snapshots. Adaptations go to the installed copy and patches/ only.",
      "Dependency skills (grilling, domain-modeling, codebase-design, setup-matt-pocock-skills) must sit in the same search path as their callers, each in its own directory. Never nest them inside grill-me/.",
      "Identical for all four harnesses; there is no per-harness install difference beyond the ui-ux-pro-max path rule."
    ]
  },
  "self_check": [
    "grilling, domain-modeling, codebase-design, setup-matt-pocock-skills resolve by name (frontmatter name:), not just by directory.",
    "python <repo>/project/ui-ux-pro-max/scripts/search.py \"<query>\" --domain ux runs (absolute path).",
    "agent-browser --version prints a version; if not, report 'documentation only, browser commands unavailable'.",
    "Call names match SKILL.md name:, and browser usage goes through 'core'."
  ],
  "update_check": {
    "latest_commit_for_path": "GET https://api.github.com/repos/{repo}/commits?path={path}&per_page=1",
    "tree_listing": "GET https://api.github.com/repos/{repo}/git/trees/{branch}?recursive=1",
    "raw_file": "https://raw.githubusercontent.com/{repo}/{branch}/{path}/{file}",
    "note": "Compare the whole path, not only SKILL.md: scripts/, references/, data/ and agents/ change independently. Do not write adaptations back into the snapshot directories."
  },
